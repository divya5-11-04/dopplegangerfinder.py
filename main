"""dopplegangerfinder: find (and optionally remove) duplicate files fast.

Strategy (why it's quick on big folders):
  1. Group files by size. A unique size can't have a duplicate.
  2. Hash only the first 64 KB of the survivors.
  3. Fully hash only files that still collide.

Usage:
  python dopplegangerfinder.py ~/Downloads
  python dopplegangerfinder.py ~/Downloads --delete --min-size 1048576
"""
from pathlib import Path
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
import hashlib


CHUNK_SIZE = 1024 * 1024       # 1 MB
HEAD_SIZE = 64 * 1024          # 64 KB


def hash_file(path, head_only=False):
    """Return the BLAKE2b hash of a file."""

    hasher = hashlib.blake2b()

    with open(path, "rb") as file:
        if head_only:
            hasher.update(file.read(HEAD_SIZE))
        else:
            while chunk := file.read(CHUNK_SIZE):
                hasher.update(chunk)

    return hasher.hexdigest()


def find_duplicates(folder):
    # Step 1: Group files by size
    by_size = defaultdict(list)

    for path in Path(folder).rglob("*"):
        if path.is_file() and not path.is_symlink():
            by_size[path.stat().st_size].append(path)

    # Step 2: Only keep files whose size occurs more than once
    candidates = [
        path
        for files in by_size.values()
        if len(files) > 1
        for path in files
    ]

    # Step 3: Hash first 64 KB concurrently
    with ThreadPoolExecutor(max_workers=8) as pool:
        partial_hashes = pool.map(
            lambda path: hash_file(path, head_only=True),
            candidates
        )

    by_partial_hash = defaultdict(list)

    for path, hash_value in zip(candidates, partial_hashes):
        by_partial_hash[hash_value].append(path)

    # Step 4: Only fully hash files that still collide
    final_candidates = [
        path
        for files in by_partial_hash.values()
        if len(files) > 1
        for path in files
    ]

    with ThreadPoolExecutor(max_workers=8) as pool:
        full_hashes = pool.map(hash_file, final_candidates)

    by_full_hash = defaultdict(list)

    for path, hash_value in zip(final_candidates, full_hashes):
        by_full_hash[hash_value].append(path)

    # Step 5: Return only actual duplicate groups
    return [
        files
        for files in by_full_hash.values()
        if len(files) > 1
    ]


duplicates = find_duplicates("Downloads")

for group in duplicates:
    print("\nDuplicate files:")

    for file in group:
        print(" ", file)
